    "web": "expo start --web",
    "postinstall": "node -e \"const fs=require('fs'),f='node_modules/@expo/ws-tunnel/build/index.js';if(fs.existsSync(f)){let c=fs.readFileSync(f,'utf8');if(c.includes('new s.WebSocket(')){fs.writeFileSync(f,c.replace('new s.WebSocket(','new (s.WebSocket||s)('),'utf8')}}\""
